From d6cbdaa831939edce57f3bce4ded43aa82ae0e2a Mon Sep 17 00:00:00 2001
From: Johannes Meyer zum Alten Borgloh <code@jzab.de>
Date: Fri, 23 Oct 2026 21:24:31 +0200
Subject: [PATCH 3/5] user_manager: Do not create per-app launchers on Sailfish
 OS

On Sailfish OS the launchers would run "waydroid app launch" directly in
Lipstick, where the Android window gets no touch input. Android apps are
used in waydroid-runner instead. The user manager keeps running, so
userUnlocked still reports the unlocked user (unlocked_cb, adb).

Replaces the Sailfish packaging's 0001-disable-user-manager.patch, which
stopped the whole thread and with 1.6 would also stop unlocked_cb.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tools/services/user_manager.py | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/tools/services/user_manager.py b/tools/services/user_manager.py
index 517812f..5d967a9 100644
--- a/tools/services/user_manager.py
+++ b/tools/services/user_manager.py
@@ -94,6 +94,10 @@ def start(args, session, unlocked_cb=None):
     def updateDesktopFile(appInfo):
         if appInfo is None:
             return
+        # Sailfish OS: no per-app launchers. They run "waydroid app launch"
+        # directly in Lipstick, where the Android window gets no touch input;
+        # Android apps are used in waydroid-runner instead.
+        return
 
         packageName = appInfo["packageName"]
         desktop_file_path = apps_dir / f"waydroid.{packageName}.desktop"
-- 
