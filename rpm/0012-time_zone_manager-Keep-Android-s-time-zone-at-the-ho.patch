diff --git a/tools/services/time_zone_manager.py b/tools/services/time_zone_manager.py
new file mode 100644
index 0000000..3b52062
--- /dev/null
+++ b/tools/services/time_zone_manager.py
@@ -0,0 +1,72 @@
+# SPDX-FileCopyrightText: Johannes Meyer zum Alten Borgloh
+# SPDX-License-Identifier: GPL-3.0-or-later
+# Keeps Android's time zone at the host's. The container manager sets it
+# (SyncTimeZone: Android's AlarmManager through lxc-attach, which needs root)
+# once Android's user is unlocked, and whenever /etc/localtime or a symlink
+# it goes through changes.
+import logging
+import os
+import threading
+import dbus
+import tools.helpers.ipc
+from gi.repository import Gio, GLib
+
+monitors = []
+pending_sync = 0
+
+def sync():
+    def ask():
+        try:
+            tools.helpers.ipc.DBusContainerService().SyncTimeZone()
+        except dbus.DBusException as e:
+            logging.warning("Failed to set Android's time zone: %s", e)
+    # lxc-attach takes a moment: not in the caller's thread
+    threading.Thread(target=ask, daemon=True).start()
+
+def localtime_paths():
+    # /etc/localtime and the symlinks it goes through: on Sailfish OS timed
+    # replaces /var/lib/timed/localtime, which /etc/localtime points to
+    paths = ["/etc/localtime"]
+    while os.path.islink(paths[-1]):
+        target = os.path.join(os.path.dirname(paths[-1]), os.readlink(paths[-1]))
+        if target in paths or not os.path.islink(target):
+            break
+        paths.append(target)
+    return paths
+
+def watch():
+    global monitors
+    for monitor in monitors:
+        monitor.cancel()
+    monitors = []
+    for path in localtime_paths():
+        monitor = Gio.File.new_for_path(path).monitor_file(Gio.FileMonitorFlags.WATCH_MOVES, None)
+        monitor.connect("changed", on_changed)
+        monitors.append(monitor)
+
+def on_changed(monitor, file, other_file, event_type):
+    # A replaced link comes as several events: act once they are over
+    global pending_sync
+    if pending_sync:
+        GLib.source_remove(pending_sync)
+    pending_sync = GLib.timeout_add(500, on_settled)
+
+def on_settled():
+    global pending_sync
+    pending_sync = 0
+    # The chain itself may have changed
+    watch()
+    sync()
+    return GLib.SOURCE_REMOVE
+
+def start(args):
+    watch()
+
+def stop(args):
+    global monitors, pending_sync
+    for monitor in monitors:
+        monitor.cancel()
+    monitors = []
+    if pending_sync:
+        GLib.source_remove(pending_sync)
+        pending_sync = 0
